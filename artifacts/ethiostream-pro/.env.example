# JJ Nexus Pro — Environment Variables
# Copy this file to .env and fill in the values

# Required for local development
PORT=5173
BASE_PATH=/

# Anthropic API Key (for Alchemist AI with live web search)
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Database (PostgreSQL)
# Local: postgresql://localhost:5432/jjnexus
# Hosted: use your Supabase, Railway, or Neon connection string
DATABASE_URL=postgresql://user:password@localhost:5432/jjnexus

# Session secret (generate a random 32+ char string)
SESSION_SECRET=change-this-to-a-random-secret-string
