# JJ NEXUS PRO — Environment Variables
# Copy this file to .env and fill in the values

# ── Anthropic API Key ──────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com
# Required for: Alchemist AI chat, Forex analysis, News analysis, Trade insights
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ── PostgreSQL Database ────────────────────────────────────────────────────────
# Local example: postgresql://postgres:password@localhost:5432/jjnexus
# Supabase: get from Project Settings → Database
# Railway: get from your Railway Postgres service
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/jjnexus

# ── Session Secret ─────────────────────────────────────────────────────────────
# Generate a random 32+ character string
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret-string

# ── Optional: Override ports ───────────────────────────────────────────────────
# API_PORT=8080     (default)
# VITE_PORT=5173    (default)
